# Copier en .env (non versionné) et remplir.

# Compte bot Twitch qui écrit dans le chat (scopes chat:read et chat:edit).
# Sans ces deux valeurs, l'agent lit le chat en anonyme et ne répond que
# dans le terminal.
TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=

# Mot de passe du serveur WebSocket d'OBS, si l'authentification est activée.
OBS_WEBSOCKET_PASSWORD=
